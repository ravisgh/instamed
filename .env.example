# InstaMed API configuration. Copy to .env and fill in real values. Never commit .env.
# Lines starting with "#" keep the built-in default.

# --- Core ---
# development | test | production  (production needs a strong JWT_SECRET and hides /docs)
ENVIRONMENT=development
MONGO_URI=mongodb://localhost:27017
DB_NAME=instamed_dev

# --- Auth ---
# Production: 32+ random chars ->  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=14

# --- HTTP ---
# CORS_ORIGINS=https://app.example.com
# DOCS_ENABLED=true

# --- Search (optional; unset = MongoDB fallback) ---
# ELASTICSEARCH_URL=http://127.0.0.1:9200

# --- Logging and metrics ---
LOG_LEVEL=INFO
LOG_FORMAT=text
# METRICS_TOKEN=
